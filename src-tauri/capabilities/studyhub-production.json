{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "studyhub-production",
  "description": "Production StudyHub Local desktop capability: local-only navigation and OAuth-only Canvas connection.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/langming58-hash/studyhub-local" },
        { "url": "https://github.com/langming58-hash/studyhub-local/releases" },
        { "url": "https://github.com/langming58-hash/studyhub-local/issues/new/choose" }
      ]
    },
    "allow-choose-study-folder",
    "allow-choose-study-files",
    "allow-choose-backup-archive",
    "allow-choose-restore-relink-file",
    "allow-canvas-connection-status",
    "allow-start-canvas-oauth",
    "allow-cancel-canvas-oauth",
    "allow-complete-canvas-oauth",
    "allow-disconnect-canvas",
    "allow-restart-backend",
    "allow-retry-backend",
    "allow-startup-diagnostics"
  ]
}
