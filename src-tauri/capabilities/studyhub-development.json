{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "studyhub-development",
  "description": "Development StudyHub desktop capability: production commands plus development-only Canvas provisioning.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/langming58-hash/studyhub-local" },
        { "url": "https://github.com/langming58-hash/studyhub-local/releases" },
        { "url": "https://github.com/langming58-hash/studyhub-local/issues/new/choose" }
      ]
    },
    "allow-choose-study-folder",
    "allow-choose-study-files",
    "allow-choose-backup-archive",
    "allow-choose-restore-relink-file",
    "allow-canvas-connection-status",
    "allow-configure-canvas-development-connection",
    "allow-provision-canvas-oauth-client",
    "allow-start-canvas-oauth",
    "allow-cancel-canvas-oauth",
    "allow-complete-canvas-oauth",
    "allow-disconnect-canvas",
    "allow-deadline-notification-status",
    "allow-set-deadline-notifications-enabled",
    "allow-evaluate-deadline-notifications",
    "allow-open-canvas-url",
    "allow-restart-backend",
    "allow-retry-backend",
    "allow-startup-diagnostics"
  ]
}
