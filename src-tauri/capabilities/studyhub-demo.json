{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "studyhub-demo",
  "description": "Demo/Test StudyHub capability: no Canvas credential or provisioning access.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/langming58-hash/studyhub-local" },
        { "url": "https://github.com/langming58-hash/studyhub-local/releases" },
        { "url": "https://github.com/langming58-hash/studyhub-local/issues/new/choose" }
      ]
    },
    "allow-choose-study-folder",
    "allow-choose-study-files",
    "allow-choose-backup-archive",
    "allow-choose-restore-relink-file",
    "allow-canvas-connection-status",
    "allow-restart-backend",
    "allow-retry-backend",
    "allow-startup-diagnostics"
  ]
}
