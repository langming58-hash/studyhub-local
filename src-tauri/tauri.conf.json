{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyHub Local",
  "version": "0.3.0-beta.1",
  "identifier": "io.studyhublocal.desktop",
  "build": {
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../static/": "static/",
      "../node_modules/katex/dist/": "katex/",
      "backend/studyhub-backend/": "backend/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
