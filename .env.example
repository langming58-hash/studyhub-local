# Copy to .env.local for local overrides.
# Never commit .env.local.

# Optional local study library. Leave blank to start with an empty managed workspace.
# STUDY_LIBRARY_PATH=~/StudyLibrary

# Runtime metadata stays local and should not be committed.
DATABASE_PATH=./data/studyhub.sqlite

# Localhost only by default.
HOST=127.0.0.1
PORT=8765

# Optional PDF text extraction. Install Poppler, or point this at its bin directory.
# STUDYHUB_POPPLER_BIN=/opt/homebrew/bin

# Optional AI integration. Keep keys server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_VECTOR_STORE_ID=
