# Copy to .env.local for local overrides.
# Never commit .env.local.

# Demo mode uses the synthetic fixtures in ./demo-data by default.
DEMO_MODE=true

# To use your own files, set DEMO_MODE=false and point this to your local library.
# STUDY_LIBRARY_PATH=~/StudyLibrary

# Runtime metadata stays local and should not be committed.
DATABASE_PATH=./data/studyhub.sqlite

# Localhost only by default.
HOST=127.0.0.1
PORT=8765

# Optional AI integration. Keep keys server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_VECTOR_STORE_ID=
